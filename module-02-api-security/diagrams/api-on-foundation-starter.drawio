<mxfile host="app.diagrams.net" type="device">
  <diagram name="api-on-foundation" id="hwz-module2-starter">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="note" value="STARTER TEMPLATE (module 2). Extend your Chapter 8 foundation diagram: the API container is placed above it. Your job: list the four controls inside the API box, then draw and label the three real flows — assumes the least-privilege role (identity), reads its credential from Secrets Manager (a secret), reaches the model through the Bedrock endpoint in the private subnets (the model call). Then add one line to the controls strip: API layer — audience-bound tokens, schema, per-token caps, structured audit." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FDECEE;strokeColor=#D7261E;fontColor=#111111;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1020" height="72" as="geometry" />
        </mxCell>
        <mxCell id="api" value="Inference API   POST /v1/complete   (this module, weak then hardened)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=none;strokeColor=#D7261E;fontColor=#D7261E;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="120" width="860" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ctl1" value="1. Audience-bound&#10;token verification&#10;(list the control)" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="150" y="160" width="190" height="86" as="geometry" />
        </mxCell>
        <mxCell id="ctl2" value="2. JSON Schema&#10;on the body" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="160" width="190" height="86" as="geometry" />
        </mxCell>
        <mxCell id="ctl3" value="3. Per-token&#10;rate + cost cap" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="570" y="160" width="190" height="86" as="geometry" />
        </mxCell>
        <mxCell id="ctl4" value="4. Structured&#10;audit logging" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#111111;strokeColor=#111111;fontColor=#FFFFFF;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="780" y="160" width="170" height="86" as="geometry" />
        </mxCell>
        <mxCell id="found" value="THE FOUNDATION  (Chapter 8, pinned hardened)  — reuse your module-01 diagram here" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;dashed=1;fillColor=#F4F4F5;strokeColor=#666666;fontColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="330" width="860" height="200" as="geometry" />
        </mxCell>
        <mxCell id="f_iam" value="IAM role&#10;least-privilege" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="150" y="380" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f_sec" value="Secrets Manager&#10;API credential" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="470" y="380" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f_bed" value="Bedrock endpoint&#10;in private subnets" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="380" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="flow_hint" value="Draw and label three arrows from the API down to these three: identity, secret, model call." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#999999;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="150" y="470" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="strip" value="Controls strip: your seven foundation controls, plus one new box — API layer: audience-bound tokens, schema, per-token caps, structured audit." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#111111;strokeColor=#111111;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1020" height="60" as="geometry" />
