        </mxCell>
        <mxCell id="legend_hint" value="Solid arrow = data flow&#10;Dashed arrow = identity / trust&#10;Red arrow = log delivery&#10;(edit to match what you draw)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#666666;fontSize=10;spacingLeft=8;" vertex="1" parent="1">
