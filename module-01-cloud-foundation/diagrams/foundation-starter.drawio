<mxfile host="app.diagrams.net" type="device">
  <diagram name="foundation" id="hwz-foundation-starter">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="note1" value="STARTER TEMPLATE. The containers are placed for you: the account, the VPC, and the subnets. Your job: place the seven foundation components inside the container each one truly runs in, label each with five words plus the one value that matters, draw arrows only for real flows (data, identity, log delivery), then fill the legend and the controls strip. The placing is the learning." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FDECEE;strokeColor=#D7261E;fontColor=#111111;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1020" height="64" as="geometry" />
        </mxCell>
        <mxCell id="acct" value="AWS Account (isolated sandbox)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;dashed=1;fillColor=none;strokeColor=#666666;fontColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="104" width="700" height="560" as="geometry" />
        </mxCell>
        <mxCell id="vpc" value="VPC  hwz-lab  10.20.0.0/16" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=none;strokeColor=#D7261E;fontColor=#D7261E;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="150" width="440" height="490" as="geometry" />
        </mxCell>
        <mxCell id="pub_a" value="Public subnet&#10;10.20.0.0/24  (AZ a)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#F7F7F7;strokeColor=#111111;fontColor=#111111;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="196" width="190" height="170" as="geometry" />
        </mxCell>
        <mxCell id="pub_b" value="Public subnet&#10;10.20.1.0/24  (AZ b)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#F7F7F7;strokeColor=#111111;fontColor=#111111;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="196" width="190" height="170" as="geometry" />
        </mxCell>
        <mxCell id="priv_a" value="Private subnet&#10;10.20.10.0/24  (AZ a)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;fontSize=11;dashPattern=4 2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="400" width="190" height="170" as="geometry" />
