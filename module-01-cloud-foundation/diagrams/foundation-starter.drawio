        <mxCell id="priv_b" value="Private subnet&#10;10.20.11.0/24  (AZ b)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;fontSize=11;dashPattern=4 2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="400" width="190" height="170" as="geometry" />
        </mxCell>
        <mxCell id="regional_hint" value="Regional services live inside the account but outside the VPC. Which of the seven components belong in this space?" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#999999;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="530" y="300" width="190" height="120" as="geometry" />
