        <mxCell id="legend" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;fontSize=12;fontStyle=1;" vertex="1" parent="1">
