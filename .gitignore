# Terraform state and vars: never commit these
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/
.terraform.lock.hcl
# Plan files: a plan file is a zip with an embedded state snapshot.
# The pair *.tfplan AND tfplan* matters: the file actually created is often
# named just "tfplan", which slips past *.tfplan.
*.tfplan
tfplan*
plan.out
crash.log
*.pem
*credentials*
# Python
__pycache__/
*.pyc
.venv/
venv/
# local snapshots the scanner writes
snapshot*.json
!scan/fixtures/*.json
.env
