# Terraform state: never commit this. It holds resource IDs, ARNs, account
# numbers, and sometimes secrets in plaintext.
*.tfstate
*.tfstate.*

# Variable files are ignored by default because a student's own .tfvars will
# contain their account ID and region.
#
# The two exceptions below are NOT student files -- they are course content.
# baseline.tfvars is the deliberately weak profile and hardened.tfvars is the
# fixed one, and the entire teaching method is "deploy baseline, scan, switch
# to hardened, scan again." A bare *.tfvars rule silently excluded both from
# every module, so the repo shipped labs that could not be run. Keep these
# negations. If you add a new profile, add it here too.
*.tfvars
!*.tfvars.example
!baseline.tfvars
!hardened.tfvars

.terraform/
.terraform.lock.hcl
# Plan files: a plan file is a zip with an embedded state snapshot.
# The pair *.tfplan AND tfplan* matters: the file actually created is often
# named just "tfplan", which slips past *.tfplan.
*.tfplan
tfplan*
plan.out
crash.log
*.pem
*credentials*
# Python
__pycache__/
*.pyc
.venv/
venv/
# local snapshots the scanner writes
snapshot*.json
!scan/fixtures/*.json
.env

# Terraform build artifacts. The producers module zips its Lambda source
# into .build/ at plan time; that zip is generated, machine-specific, and
# was staged by accident in the launch commit.
.build/
*.zip
!hwz-course-repo*.zip
