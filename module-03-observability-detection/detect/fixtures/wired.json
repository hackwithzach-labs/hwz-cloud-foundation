{
  "_comment": "HARDENED detection profile. Two app-layer metric filters (each with an alarm publishing to the alert topic), three control-plane EventBridge rules (ENABLED, each targeting SNS), a confirmed alert subscription, and GuardDuty/Config/Security Hub on. detect.py should return zero gaps against this.",
  "metric_filters": [
    {"name": "unauthorized-access", "metric_name": "UnauthorizedAccess"},
    {"name": "cost-cap-breach", "metric_name": "CostCapBreach"}
  ],
  "alarms": [
    {"metric": "UnauthorizedAccess", "alarm_actions": ["arn:aws:sns:us-east-1:000000000000:hwz-lab-alerts"]},
    {"metric": "CostCapBreach", "alarm_actions": ["arn:aws:sns:us-east-1:000000000000:hwz-lab-alerts"]}
  ],
  "eventbridge_rules": [
    {"name": "cloudtrail-tamper", "state": "ENABLED", "targets_sns": true},
    {"name": "sg-open-to-world", "state": "ENABLED", "targets_sns": true},
    {"name": "root-account-use", "state": "ENABLED", "targets_sns": true}
  ],
  "alert_topic": {"exists": true, "name": "hwz-lab-alerts", "confirmed_subscriptions": 1},
  "guardduty": {"enabled": true},
  "config": {"recording": true, "rules": 3},
  "security_hub": {"enabled": true},
  "cloudtrail": {"delivering_to_s3": true}
}
